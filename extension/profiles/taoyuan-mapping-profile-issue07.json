            { "kind": "plain", "value": "#CarNum2" }
          ]
        },
        "date": {
          "riskField": false,
          "selector": [
            { "kind": "plain", "value": "#cardate", "transform": "westernSlash" }
          ]
        },
        "time": {
          "riskField": false,
          "selector": [
            { "kind": "plain", "value": "#carTime", "transform": "colonSeparated" }
          ]
        },
        "location": {
          "riskField": true,
          "selector": [
            { "kind": "select", "value": "#city", "role": "city" },
            { "kind": "select", "value": "#village", "role": "district" },
            { "kind": "custom", "value": "#selectize_Road-selectized", "role": "road" },
            { "kind": "plain", "value": "#addAlley", "role": "alley" },
            { "kind": "plain", "value": "#addLane", "role": "lane" },
            { "kind": "plain", "value": "#addSubLane", "role": "subLane" },
