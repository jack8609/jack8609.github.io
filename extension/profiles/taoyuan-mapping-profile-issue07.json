          ]
        },
        "evidenceImages": {
          "riskField": false,
          "selector": [
            { "kind": "file-slots", "value": "#files1" },
            { "kind": "file-slots", "value": "#files2" },
            { "kind": "file-slots", "value": "#files3" },
            { "kind": "file-slots", "value": "#files4" },
            { "kind": "file-slots", "value": "#files5" }
