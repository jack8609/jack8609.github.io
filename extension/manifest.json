{
  "manifest_version": 3,
  "name": "違規檢舉小幫手",
  "version": "0.1.0",
  "description": "把違規檢舉小幫手網站編輯好的違規資料半自動轉貼到政府檢舉網站表單。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "host_permissions": ["https://jack8609.github.io/*"],
  "optional_host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js",
        "content/selector-resolve.js",
        "content/vuetify-dropdown-interaction.js",
        "content/evidence-upload.js"
      ],
      "matches": ["*://*/*"]
    }
  ]
}
